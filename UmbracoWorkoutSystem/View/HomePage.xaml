<Page x:Class="UmbracoWorkoutSystem.View.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UmbracoWorkoutSystem.View"
      mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
  Title="HomePage" Background="#f1f0ee">
    <Grid>
        <Image Source="/View/Pictures/FrontPageBanner1.png"
        Width="640" Height="140"
   HorizontalAlignment="Center"
   VerticalAlignment="Top"
   Stretch="UniformToFill"
   Margin="10"/>
        <Border BorderBrush="#283a97" BorderThickness="2" Margin="20,176,540,20">
            <StackPanel>
                <Label Content="Leaderboards!" FontSize="35" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Label Content="1. Lars!   9000" FontSize="30" FontWeight="Bold"/>
                <Label Content="2. Jan!    129"  FontSize="30" FontWeight="Bold"/>
                <Label Content="3. Peter!  101"  FontSize="30" FontWeight="Bold"/>
                <Label Content="4. Per!     93"  FontSize="30" FontWeight="Bold"/>
                <Label Content="5. Leif!    66"  FontSize="30" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Grid Margin="524,176,32,20">

            <Border BorderBrush="#283a97" BorderThickness="2" >
                <TextBlock x:Name="NewsDate" TextWrapping="Wrap" Text="{Binding NextEvent.Date, UpdateSourceTrigger=PropertyChanged}" Margin="0,112,0,454" HorizontalAlignment="Center" FontSize="17" Width="66" />

            </Border>
            <TextBlock x:Name="NewsTitle" TextWrapping="Wrap" Text="{Binding NextEvent.Title}" Margin="0,62,0,512" HorizontalAlignment="Center" FontWeight="Bold" FontSize="25" Width="134"/>
            <TextBlock x:Name="NewsDescribtion" Text="{Binding NextEvent.Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="43,194,43,264" FontSize="17" />



        </Grid>
        <Image x:Name="NewsImg" HorizontalAlignment="Left" Height="154" Margin="624,556,0,0" VerticalAlignment="Top" Width="266"/>

    </Grid>
</Page>
