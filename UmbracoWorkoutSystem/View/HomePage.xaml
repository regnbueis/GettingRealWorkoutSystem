<Page x:Class="UmbracoWorkoutSystem.View.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UmbracoWorkoutSystem.View"
      mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
  Title="HomePage" Background="#f1f0ee">
    <Grid>
        <Image Source="\Pictures\FrontPageBanner1.png"
   Width="640" Height="140"
   HorizontalAlignment="Center"
   VerticalAlignment="Top"
   Stretch="UniformToFill"
   Margin="10"/>
        <Border BorderBrush="#283a97" BorderThickness="2" Margin="20,176,540,20">
            <StackPanel>
                <Label Content="Leaderboards!" FontSize="35" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Label Content="1. Lars!   9000" FontSize="30" FontWeight="Bold"/>
                <Label Content="2. Jan!    129"  FontSize="30" FontWeight="Bold"/>
                <Label Content="3. Peter!  101"  FontSize="30" FontWeight="Bold"/>
                <Label Content="4. Per!     93"  FontSize="30" FontWeight="Bold"/>
                <Label Content="5. Leif!    66"  FontSize="30" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="#283a97" BorderThickness="2" Margin="532,176,20,20">
            <StackPanel>
                <Label Content="News!" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock TextWrapping="Wrap"
               Text="Der er et nyt event. Klik her og tilmeld dig allerede i dag!"
               FontSize="25" Margin="5"/>
                <TextBlock TextWrapping="Wrap"
               Text="Ny øvelse, du kan afprøve nu, den tager kun 3 minutter.1"
               FontSize="25" Margin="5"/>
                <TextBlock TextWrapping="Wrap"
               Text="Der er tilføjet en irriterende pop-up vindue, for at lette din fede røv!"
               FontSize="25" Margin="5"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>
